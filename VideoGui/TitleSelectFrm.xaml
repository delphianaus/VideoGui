<ui:FluentWindow x:Name="frmTitleEditor" x:Class="VideoGui.TitleSelectFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="clr-namespace:VideoGui"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        d:Background="Gray"
        Title="Select Title" Height="496" Width="710" Loaded="frmTitleEditor_Loaded" 
        Closing="frmTitleEditor_Closing" SizeToContent="Manual" WindowStyle="ToolWindow" 
        WindowStartupLocation="CenterScreen" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/FluentWindowControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid Height="472" x:Name="gr1" VerticalAlignment="Top" Width="695" Margin="5,0,0,0" HorizontalAlignment="Left" >

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Name="TtefTitle" Title="Select Title" Height="30" Grid.ColumnSpan="2" VerticalAlignment="Center">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Icons/computer.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1" Height="442" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center" Width="696" VerticalAlignment="Center">
            <Border x:Name="brdShortsVideoCat" BorderThickness="2" BorderBrush="CadetBlue" Margin="4,291,15,52">
                <ListBox x:Name="lstTitles" MinWidth="100" MinHeight="54" MouseDoubleClick="lstTitles_MouseDoubleClick">
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Multiple" 
                   ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Visible" Width="171">
                    <ListBox.Resources>
                        <!--Defines a context menu-->
                        <ContextMenu x:Key="MyElementMenu">
                            <MenuItem Name="mnuUseTags" Header="Use These Tags" Click="mnuUseTags_Click"/>
                        </ContextMenu>
                        <!--Sets a context menu for each ListBoxItem in the current ListBox-->
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="ContextMenu" Value="{StaticResource MyElementMenu}"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:Name="GridControlsB" >
                            <Grid Margin="0,2" x:Name="gridwidths">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0"/>
                                    <ColumnDefinition Width="0"/>
                                    <ColumnDefinition Width="270"/>
                                    <ColumnDefinition Width="210*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Id" Grid.Column="0" Margin="4,0,0,0" Width="0" Text="{Binding GroupId}"/>
                                <TextBlock x:Name="Ids" Grid.Column="1" Margin="4,0,0,0" Width="0" Text="{Binding Ids}"/>
                                <TextBlock x:Name="Name" Grid.Column="2" Margin="4,0,0,0" Text="{Binding Name}"/>
                                <TextBlock x:Name="Tags" Grid.Column="3" Margin="4,0,0,0" Text="{Binding Tags}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Button x:Name="btnclose" Content="Close" Height="30" Width="100" HorizontalAlignment="Right" 
                Margin="0,0,17,7" VerticalAlignment="Bottom" Click="btnclose_Click"/>
            <Border x:Name="brdShortsVideoCa1t" BorderThickness="2" BorderBrush="CadetBlue" Height="27" 
                Width="645" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,26,0,0">
                <TextBox x:Name="txtTitle" HorizontalAlignment="Stretch" TextWrapping="Wrap" 
                     VerticalAlignment="Stretch" KeyUp="txtTitle_KeyUp" FontSize="14" Grid.IsSharedSizeScope="True"/>
            </Border>
            <Border x:Name="brdTags" BorderThickness="2" BorderBrush="CadetBlue" 
                Height="228" Width="175" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,58,0,0">
                <ListBox x:Name="TagsGrp" 
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Multiple"
                PreviewMouseRightButtonDown="TagsGrp_PreviewMouseRightButtonDown"
                ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Visible" IsManipulationEnabled="True" MouseDoubleClick="TagsGrp_MouseDoubleClick">
                    <ListBox.Resources>
                        <!--Defines a context menu-->
                        <ContextMenu x:Key="MyElementMenuTagsGrp">
                            <MenuItem x:Name="mnuUseRemoveTags" Header="Remove These Tags" Click="btnRemoveTags_Click"/>
                        </ContextMenu>
                        <!--Sets a context menu for each ListBoxItem in the current ListBox-->
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="ContextMenu" Value="{StaticResource MyElementMenuTagsGrp}"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate >
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="col1" Width="0"/>
                                    <ColumnDefinition x:Name="col2" Width="155" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Id" Grid.Column="0" Margin="4,0,0,0" Width="0" Text="{Binding Id}"/>
                                <TextBlock x:Name="Description" Grid.Column="1" Margin="4,0,0,0" Text="{Binding Description}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Label x:Name="lblTitleName" Content="Title :" HorizontalAlignment="Left" FontSize="14"
            Margin="5,0,0,47" VerticalAlignment="Top" MouseDoubleClick="lblTitleName_MouseDoubleClick"/>
            <Border x:Name="brdTags_Copy" BorderThickness="2" BorderBrush="CadetBlue" 
            Height="195" Width="214" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="229,58,0,0">
                <ListBox x:Name="TagAvailable" 
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Multiple" 
                ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Visible" MouseDoubleClick="TagAvailable_MouseDoubleClick"
                PreviewMouseRightButtonDown="TagAvailable_PreviewMouseRightButtonDown">
                    <ListBox.Resources>
                        <!--Defines a context menu-->
                        <ContextMenu x:Key="MyElementMenuTagAvailable">
                            <MenuItem x:Name="mnuUseAddTags" Header="Add These Tags" Click="mnuUseAddTags_Click"/>
                        </ContextMenu>
                        <!--Sets a context menu for each ListBoxItem in the current ListBox-->
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="ContextMenu" Value="{StaticResource MyElementMenuTagAvailable}"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="col1" Width="0"/>
                                    <ColumnDefinition x:Name="col2" Width="175" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Id" Grid.Column="0" Margin="4,0,0,0" Width="0" Text="{Binding Id}"/>
                                <TextBlock x:Name="Description" Grid.Column="1" Margin="4,0,0,0" Text="{Binding Tag}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Label x:Name="lblTitleLength" Content="100" HorizontalAlignment="Left" 
            Margin="665,23,0,0" VerticalAlignment="Top"/>
            <Button x:Name="btnRemTag" Click="btnInsertTags_Click" Background="#FF262727" Margin="189,150,0,0" 
                VerticalAlignment="Top" IsEnabled="True" Width="26" Height="26">
                <Image x:Name="ImgAdd" Source="/Icons/LeftArrow.png" IsEnabled="True" Width="22" Height="22" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" />
            </Button>
            <Button x:Name="btnAddTag" Background="#FF262727" Click="btnRemoveTags_Click" Margin="189,98,308,130" Width="26" Height="26"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsEnabled="True">
                <Image x:Name="ImgRemove" Source="/Icons/RightArrow..png" IsEnabled="True" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Button>
            <Button x:Name="btnSelect" Click="btnSelect_Click" Margin="189,197,0,0" Background="#FF262727"
                Width="26" Height="26" VerticalAlignment="Top" >
                <Image Source="/Icons/SelectDown.png"/>
            </Button>
            <Border x:Name="brdShortsVideoCa1t_Copy" BorderThickness="2" BorderBrush="CadetBlue" Height="28" 
            Width="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="229,258,0,0">
                <TextBox x:Name="txtNewTag" HorizontalAlignment="Stretch" TextWrapping="Wrap" 
                VerticalAlignment="Stretch" KeyUp="txtTitle_KeyUp" FontSize="14"/>
            </Border>
            <Button x:Name="btnAdd" Click="btnAdd_Click" Margin="654,259,0,0" Background="#FF262727"
                VerticalAlignment="Top" Height="26" Width="26">
                <Image Source="/Icons/plus.png"/>
            </Button>
            <Label x:Name="txtBaseTitle" Content="" HorizontalAlignment="Left" FontSize="14"
            Margin="53,0,0,0" VerticalAlignment="Top" Width="611" MouseDoubleClick="txtBaseTitle_MouseDoubleClick"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
