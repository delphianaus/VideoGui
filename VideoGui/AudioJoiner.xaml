<ui:FluentWindow x:Class="VideoGui.AudioJoiner" Name="frmAudioJoiner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="clr-namespace:VideoGui" Loaded="Window_Loaded" 
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        xmlns:MSU="clr-namespace:CustomComponents.ListBoxExtensions;assembly=CustomComponents"
        mc:Ignorable="d" d:Background="Gray"
        WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow" 
        Title="Audio Joiner" Height="362" Width="729" SizeChanged="Window_SizeChanged" >
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/FluentWindowControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Name="AAudioJoiner" Grid.Row="0" Title="Audio Joiner" Height="30">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Icons/computer.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Canvas VerticalAlignment="Top">
                <Border x:Name="brdFileInfo" BorderThickness="2" BorderBrush="Black" Height="49" Margin="6,3,5,0" Width="717" VerticalAlignment="Top">
                    <Canvas x:Name="CnvMedialElements" Margin="0,0,0,4">
                        <Label Content="Source Directory" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26" Canvas.Left="9" Canvas.Top="9" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="txtsrcdir" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="429" Canvas.Left="120" Canvas.Top="14"/>
                        <Button x:Name="btnSelectSourceDir" Width="20" Height="20" Canvas.Left="554" Canvas.Top="12" Click="btnSelectSourceDir_Click"  VerticalAlignment="Top" HorizontalAlignment="Center" />
                        <CheckBox x:Name="chkDest" Content="Custom Destination" Canvas.Top="12" Width="124"  Canvas.Left="579" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Canvas>
                </Border>
                <MSU:MultiListbox x:Name="msuAudioJoiner" ItemHeight="15"
        Header="Source Files" Width="722" FontSize="13" IsDarkMode="True"
        VerticalAlignment="Top" VerticalContentAlignment="Bottom" 
        Height="207" HorizontalAlignment="Left" Margin="4,50,0,0">
                    <MSU:MultiListbox.ColumnDefinitions>
                        <MSU:MultiListboxColumnDefinition HeaderText="Source Filename" Name="filename"
                       DataField="FileName" WidthBinding="SrcFileNameWidth" ComponentType="TextBlock"/>
                        <MSU:MultiListboxColumnDefinition HeaderText="Duration" Name="duration"
                      DataField="TimeData" Width="100" ComponentType="TextBlock"/>
                        <MSU:MultiListboxColumnDefinition HeaderText="Status" 
                      DataField="Status" Width="140" ComponentType="TextBlock"/>
                    </MSU:MultiListbox.ColumnDefinitions>
                </MSU:MultiListbox>
            </Canvas>

            <Border x:Name="brdControls" BorderBrush="Black" BorderThickness="2" Height="88"  Width="716" Margin="6,0,3,6" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Canvas x:Name="cnvcontrols" Margin="0,1,0,-1">
                    <Button x:Name="btnRename" IsEnabled="False" HorizontalAlignment="Center" Content="Process ALL" Width="90" Height="30" Click="btnRename_Click" Canvas.Left="14" Canvas.Top="18" VerticalAlignment="Top"/>
                    <Button x:Name="btnClose" Content="Close" Width="90" Height="30" Click="btnClose_Click" HorizontalAlignment="Center" Canvas.Left="603" Canvas.Top="18" VerticalAlignment="Center"/>
                    <Label Name="lblSetDest" Content="Destination Directory :" Canvas.Left="111" HorizontalAlignment="Center" Canvas.Top="26" VerticalAlignment="Top"/>
                    <Button x:Name="btnSetDetDir" Width="22" Height="22" Canvas.Left="543" HorizontalAlignment="Center" VerticalAlignment="Top" Canvas.Top="22" Click="btnSetDetDir_Click"/>
                    <TextBox x:Name="txtDestDir" Width="298" Height="22" Canvas.Left="240" HorizontalAlignment="Center" Canvas.Top="22" VerticalAlignment="Center"/>
                </Canvas>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
